# Dependencies
node_modules/

# Build artefacts
dist/
build/
out/
*.tsbuildinfo

# VitePress docs site (SLS-32): build output, cache, and the report page
# synced in from eval/reports at build time (single-sourced there).
docs/.vitepress/dist/
docs/.vitepress/cache/
docs/benchmarks.md

# Environment
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Coverage
coverage/
.nyc_output/

# Python (services/mpc, services/rl) — keep uv.lock tracked for --frozen CI
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Playwright
playwright-report/
test-results/
playwright/.cache/

# Claude Code per-user settings (kept local)
.claude/settings.local.json

# Eval outputs (CI uploads them as artifacts; not versioned)
eval/results/*
# …but the curated milestone-gate records (SLS-67) are durable provenance and
# ARE tracked. Uses eval/results/* above (not eval/results/) so git descends
# into this re-included subdir.
!eval/results/gate-records/
eval/plots/

# RL training artifacts (SLS-29) — checkpoints & TB logs stay local
services/rl/checkpoints*/
services/rl/runs/
services/rl/eval/results/

# RL teacher demo datasets (SLS-51) — local only
# (covered by demos*/ below)
services/rl/demos*/

# Obsidian (SLS-120) — docs/kb doubles as an Obsidian vault.
# Per-user workspace state is noise; app.json is NOT: it pins markdown-style
# relative links so Obsidian never writes [[wikilinks]], which VitePress can't
# resolve. Keeping it committed is what stops an editor setting from silently
# breaking the docs build.
docs/kb/.obsidian/*
!docs/kb/.obsidian/app.json

# Obsidian scratch inside the vault. `docs/kb` is the canonical KB since the
# Confluence loss (SLS-118), and it is also a live editing surface — "Untitled"
# canvases and empty notes accumulate there just from clicking around. Ignoring
# them keeps a stray `git add -A` from committing editor noise into the KB.
# A canvas worth keeping: `git add -f` it, or give it a real name.
docs/kb/Untitled*.canvas
docs/kb/**/Untitled*.canvas

# Playwright run output (SLS-108). The GOLDENS in
# apps/web/e2e/__screenshots__/ are committed; these are per-run scratch.
apps/web/test-results/
apps/web/playwright-report/
